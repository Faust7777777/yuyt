<view class="container">
  <view class="login-box">
    <text class="title">预约系统登录</text>

    <view class="form-item">
      <text class="label">身份</text>
      <picker
        mode="selector"
        range="{{roleOptions}}"
        range-key="label"
        bindchange="onRoleChange"
      >
        <view class="picker">
          {{role === 'teacher' ? '教师' : '学生'}}
        </view>
      </picker>
    </view>

    <view wx:if="{{role === 'student'}}">
      <view class="form-item">
        <text class="label">学号</text>
        <input
          class="input"
          placeholder="请输入学号"
          value="{{studentNo}}"
          bindinput="onStudentNoInput"
        />
      </view>

      <view class="form-item">
        <text class="label">手机号</text>
        <input
          class="input"
          placeholder="请输入手机号"
          value="{{studentPhone}}"
          bindinput="onStudentPhoneInput"
        />
      </view>
    </view>

    <view wx:else>
      <view class="form-item">
        <text class="label">用户名</text>
        <input
          class="input"
          placeholder="请输入用户名"
          value="{{username}}"
          bindinput="onUsernameInput"
        />
      </view>

      <view class="form-item">
        <text class="label">密码</text>
        <input
          class="input"
          type="password"
          placeholder="请输入密码"
          value="{{password}}"
          bindinput="onPasswordInput"
        />
      </view>
    </view>

    <button class="login-btn" bindtap="login">登录</button>
  </view>
</view>
