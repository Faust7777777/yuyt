<view class="container">
  <view class="login-box">
    <text class="title">预约系统登录</text>

 

    <!-- 角色选择 -->
    <view class="form-item">
      <text class="label">身份</text>
      <picker 
        mode="selector" 
        range="{{roleOptions}}"
        range-key="label"
        bindchange="onRoleChange">
        <view class="picker">
          {{role === 'teacher' ? '教师' : '学生'}}
        </view>
      </picker>
    </view>

    <!-- 学生 / 教师 登录区域 -->
    <view wx:if="{{role === 'student'}}">
      <!-- 学生：学号 + 手机号 -->
      <view class="form-item">
        <text class="label">学号</text>
        <input
          class="input"
          placeholder="请输入学号"
          value="{{studentNo}}"
          bindinput="onStudentNoInput" />
      </view>

      <view class="form-item">
        <text class="label">手机号</text>
        <input
          class="input"
          placeholder="请输入手机号"
          value="{{studentPhone}}"
          bindinput="onStudentPhoneInput" />
      </view>
    </view>

    <view wx:else>
      <!-- 教师：原用户名 + 密码 -->
      <view class="form-item">
        <text class="label">用户名</text>
        <input
          class="input"
          placeholder="请输入用户名"
          value="{{username}}"
          bindinput="onUsernameInput" />
      </view>

      <view class="form-item">
        <text class="label">密码</text>
        <input
          class="input"
          type="password"
          placeholder="请输入密码"
          value="{{password}}"
          bindinput="onPasswordInput" />
      </view>
    </view>

    <!-- 登录按钮 -->
    <button class="login-btn" bindtap="login">登录</button>
  </view>
</view>
